# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Variable files often hold secrets; commit an example file instead
*.tfvars
*.tfvars.json
!example.tfvars

# --- Scanner output ---
report.json
report.md

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
